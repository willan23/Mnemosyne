VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key-here

# Stripe Price IDs (get from Stripe Dashboard → Products)
VITE_STRIPE_PRICE_PRO_MONTHLY=price_your_pro_monthly_id
VITE_STRIPE_PRICE_PRO_YEARLY=price_your_pro_yearly_id
VITE_STRIPE_PRICE_BUSINESS_MONTHLY=price_your_business_monthly_id
VITE_STRIPE_PRICE_BUSINESS_YEARLY=price_your_business_yearly_id

# Firebase Configuration (existing)
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123

# Instructions:
# 1. Get Stripe Publishable Key: Dashboard → Developers → API keys
# 2. This key is SAFE to expose in frontend
# 3. Use TEST key (pk_test_) for development
# 4. Use LIVE key (pk_live_) for production
# 5. Rename this file to .env (remove .example)
# 6. Restart dev server: npm run dev
