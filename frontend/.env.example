VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key-here

# Stripe Price IDs (get from Stripe Dashboard → Products)
VITE_STRIPE_PRICE_PRO_MONTHLY=price_your_pro_monthly_id
VITE_STRIPE_PRICE_PRO_YEARLY=price_your_pro_yearly_id
VITE_STRIPE_PRICE_BUSINESS_MONTHLY=price_your_business_monthly_id
VITE_STRIPE_PRICE_BUSINESS_YEARLY=price_your_business_yearly_id

# Firebase Configuration (existing)
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123

# App Check — preferir reCAPTCHA v3 clássico (NÃO Enterprise).
# 1) https://www.google.com/recaptcha/admin → Create → reCAPTCHA v3
#    Domains: mnemosyne-one.com, www.mnemosyne-one.com, mnemosyne-one.web.app, localhost
# 2) Firebase Console → App Check → Web app → Provider: reCAPTCHA v3 → colar site key
# 3) Modo Monitor (não Enforce)
# 4) Meter a site key abaixo (NÃO a secret key) e rebuild hosting
VITE_FIREBASE_APPCHECK_SITE_KEY=
# Só se usares Enterprise (API activa na GCP): VITE_FIREBASE_APPCHECK_PROVIDER=enterprise
VITE_FIREBASE_APPCHECK_PROVIDER=v3

# Optional Sentry (errors only; content scrubbed in monitoring/sentry.ts)
# VITE_SENTRY_DSN=

# Stripe checkout: auto-on when VITE_STRIPE_PUBLISHABLE_KEY is set.
# Set VITE_ENABLE_CHECKOUT=false to force off. Keep VITE_MONETIZATION_MODE=free-first
# unless you intentionally enforce paid entitlements in Firestore rules.
# VITE_ENABLE_CHECKOUT=true
# VITE_MONETIZATION_MODE=free-first

# Web research backend (public endpoint, no secret)
VITE_ENABLE_WEB_RESEARCH_BACKEND=true
VITE_WEB_RESEARCH_ENDPOINT=https://mnemosyne-web-research-tq3vyofasq-ew.a.run.app/api/v1/web/research

# Mnemosyne AI backend (public base URL; secrets stay in backend env)
VITE_API_URL=https://your-mnemosyne-backend.example.com

# Instructions:
# 1. Get Stripe Publishable Key: Dashboard → Developers → API keys
# 2. This key is SAFE to expose in frontend
# 3. Use TEST key (pk_test_) for development
# 4. Use LIVE key (pk_live_) for production
# 5. Copy values into .env (do not commit .env)
# 6. Restart dev server: npm run dev
# 7. App Check: only the site key in frontend — never the reCAPTCHA secret key
