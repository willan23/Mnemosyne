{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop permissions for Mnemosyne.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "process:allow-restart",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "dialog:default",
    "fs:default",
    {
      "identifier": "fs:read-all",
      "allow": [{ "path": "**" }]
    }

  ]
}
