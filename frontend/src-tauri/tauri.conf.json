{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mnemosyne",
  "version": "1.0.7",
  "identifier": "com.mnemosyne.cognitive",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:desktop",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mnemosyne Cognitive OS",
        "width": 1280,
        "height": 800,
        "decorations": true,
        "transparent": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI0NURCRTBGQkI4RjUwRDUKUldUVlVJKzdENzVkSktCM1c3ejJRWEo4NjZyZ0x3aE1GMGtDSExRVEZWVE9yemp2RGdjQTdObmgK",
      "endpoints": [
        "https://mnemosyne-one.web.app/desktop/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
