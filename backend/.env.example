# ==============================================================================
# MNEMOSYNE COGNITIVE OS - VARIÁVEIS DE AMBIENTE (EXEMPLO)
# ==============================================================================
# Copie este arquivo para .env e insira suas chaves reais.
# NÃO faça commit do arquivo .env com chaves reais!

# 1. CONFIGURAÇÕES DA API DA NVIDIA NIM
NVIDIA_API_KEY=sua_chave_nvidia_nim_aqui
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

NVIDIA_MODEL_CORE=meta/llama-3.1-70b-instruct
NVIDIA_MODEL_FAST=meta/llama-3.1-8b-instruct
NVIDIA_MODEL_EMBEDDING=nvidia/nv-embedqa-e5-v5
NVIDIA_MODEL_VISION=microsoft/phi-3.5-vision-instruct

# 2. CONFIGURAÇÕES LOCAIS (OLLAMA FALLBACK)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL_DEFAULT=llama3

# 3. BANCO DE DADOS
DATABASE_URL=sqlite:///./mnemosyne.db
