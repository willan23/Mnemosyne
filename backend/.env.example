# ==============================================================================
# MNEMOSYNE COGNITIVE OS - VARIÁVEIS DE AMBIENTE (EXEMPLO)
# ==============================================================================
# Copie este arquivo para .env e insira suas chaves reais.
# NÃO faça commit do arquivo .env com chaves reais!

# 1. CONFIGURAÇÕES DA API DA NVIDIA NIM
NVIDIA_API_KEY=sua_chave_nvidia_nim_aqui
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

NVIDIA_MODEL_CORE=meta/llama-3.1-70b-instruct
NVIDIA_MODEL_FAST=meta/llama-3.1-8b-instruct
NVIDIA_MODEL_EMBEDDING=nvidia/nv-embedqa-e5-v5
NVIDIA_MODEL_VISION=microsoft/phi-3.5-vision-instruct

# 2. GERAÇÃO HUGGING FACE (FREE-FIRST: TEXTO + IMAGEM)
# Use um token fine-grained com permissao "Make calls to Inference Providers".
HUGGINGFACE_API_KEY=sua_chave_huggingface_aqui
HUGGINGFACE_API_BASE_URL=https://router.huggingface.co
HUGGINGFACE_TEXT_MODEL=openai/gpt-oss-120b:cheapest
HUGGINGFACE_IMAGE_PROVIDER=hf-inference
HUGGINGFACE_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
HUGGINGFACE_IMAGE_STEPS_LOW=4
HUGGINGFACE_IMAGE_STEPS_MEDIUM=8
HUGGINGFACE_IMAGE_STEPS_HIGH=16

# 3. GERAÇÃO OPENAI (FALLBACK PREMIUM: TEXTO + IMAGEM)
# Guarde isto no backend/Cloud Run secret. Nunca exponha no frontend.
OPENAI_API_KEY=sua_chave_openai_aqui
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=gpt-5.5
OPENAI_IMAGE_MODEL=gpt-image-1

# 4. CONFIGURAÇÕES LOCAIS (OLLAMA FALLBACK)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL_DEFAULT=llama3

# 5. BANCO DE DADOS
DATABASE_URL=sqlite:///./mnemosyne.db
