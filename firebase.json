{
    "functions": [
        {
            "source": "functions",
            "codebase": "default",
            "ignore": [
                "node_modules",
                ".git",
                "firebase-debug.log",
                "firebase-debug.*.log",
                ".env",
                ".env.*",
                ".secret.*"
            ],
            "predeploy": [
                "npm --prefix \"$RESOURCE_DIR\" run build"
            ]
        }
    ],
    "firestore": {
        "rules": "firestore.rules",
        "indexes": "firestore.indexes.json"
    },
    "storage": {
        "rules": "storage.rules"
    },
    "emulators": {
        "firestore": {
            "port": 8080
        },
        "storage": {
            "port": 9199
        },
        "ui": {
            "enabled": false
        },
        "singleProjectMode": true
    },
    "hosting": {
        "public": "frontend/dist",
        "ignore": [
            "firebase.json",
            "**/node_modules/**"
        ],
        "rewrites": [
            {
                "source": "/api/v1/web/research",
                "function": {
                    "functionId": "webResearch",
                    "region": "europe-west1"
                }
            },
            {
                "source": "/api/v1/generate",
                "function": {
                    "functionId": "generateText",
                    "region": "europe-west1"
                }
            },
            {
                "source": "/api/v1/images/generate",
                "function": {
                    "functionId": "generateImage",
                    "region": "europe-west1"
                }
            },
            {
                "source": "/api/v1/**",
                "function": {
                    "functionId": "publicApi",
                    "region": "europe-west1"
                }
            },
            {
                "source": "/api/mcp",
                "function": {
                    "functionId": "publicApi",
                    "region": "europe-west1"
                }
            },
            {
                "source": "/mcp",
                "function": {
                    "functionId": "publicApi",
                    "region": "europe-west1"
                }
            },
            {
                "source": "**",
                "destination": "/index.html"
            }
        ],
        "headers": [
            {
                "source": "/agent/authorize",
                "headers": [
                    { "key": "X-Frame-Options", "value": "DENY" },
                    { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" },
                    { "key": "Referrer-Policy", "value": "no-referrer" },
                    { "key": "Cache-Control", "value": "no-store" }
                ]
            },
            {
                "source": "/.well-known/assetlinks.json",
                "headers": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "Access-Control-Allow-Origin",
                        "value": "*"
                    },
                    {
                        "key": "Cache-Control",
                        "value": "public, max-age=3600"
                    }
                ]
            },
            {
                "source": "/version.json",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "no-cache, no-store, must-revalidate"
                    }
                ]
            },
            {
                "source": "/desktop/latest.json",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "no-cache, no-store, must-revalidate"
                    },
                    {
                        "key": "Content-Type",
                        "value": "application/json; charset=utf-8"
                    }
                ]
            },
            {
                "source": "/index.html",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "no-cache, no-store, must-revalidate"
                    }
                ]
            },
            {
                "source": "**/*.@(js|css|webp|png|jpg|jpeg|svg|woff2)",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "public, max-age=31536000, immutable"
                    }
                ]
            }
        ]
    }
}
