{
  "name": "mnemosyne-functions",
  "version": "1.0.0",
  "description": "Firebase APIs and encrypted memory operations for Mnemosyne",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test --test-concurrency=2 test/*.test.js",
    "test:rules": "node --test test/rules.test.js",
    "deploy": "powershell -NoProfile -NonInteractive -File ../deploy.ps1"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.2.0",
    "@google-cloud/storage": "^7.22.0",
    "@google/genai": "2.30.0",
    "cheerio": "^1.2.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.4.0",
    "openai": "^7.20.0",
    "stripe": "^20.1.0",
    "undici": "7.30.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/node": "^22.15.0",
    "firebase": "^12.19.0",
    "typescript": "^5.3.3"
  },
  "private": true,
  "overrides": {
    "body-parser": "2.4.0",
    "undici": "7.30.1",
    "@tootallnate/once": "3.0.1",
    "@grpc/grpc-js": "1.14.5",
    "uuid": "11.1.1"
  }
}
