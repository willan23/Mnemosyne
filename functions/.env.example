# Placeholders only — never commit real secrets.
# Sync Stripe secrets to Secret Manager (required for defineSecret deploys):
#   powershell -File scripts/sync-function-secrets.ps1
#
# Or manually:
#   firebase functions:secrets:set STRIPE_SECRET_KEY
#   firebase functions:secrets:set STRIPE_WEBHOOK_SECRET
#
# Optional later (when ready to bind LLM secrets in runWith):
#   firebase functions:secrets:set OPENAI_API_KEY
#   firebase functions:secrets:set NVIDIA_API_KEY
#   firebase functions:secrets:set HUGGINGFACE_API_KEY
#
# Price IDs stay as dotenv (non-secret) — loaded into process.env on deploy.
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PRICE_PRO_MONTHLY=price_your_pro_monthly_id
STRIPE_PRICE_PRO_YEARLY=price_your_pro_yearly_id
STRIPE_PRICE_SOVEREIGN_MONTHLY=price_your_sovereign_monthly_id
STRIPE_PRICE_SOVEREIGN_YEARLY=price_your_sovereign_yearly_id
STRIPE_PRICE_BUSINESS_MONTHLY=price_your_business_monthly_id
STRIPE_PRICE_BUSINESS_YEARLY=price_your_business_yearly_id

# Optional LLM keys (dotenv today; migrate to secrets when binding runWith)
# OPENAI_API_KEY=
# NVIDIA_API_KEY=
# HUGGINGFACE_API_KEY=

# Public API v1 / MCP (europe-west1 function `publicApi`).
# PUBLIC_API_CORS_EXTRA_ORIGINS=https://preview.example.com
