{
  "name": "mnemosyne-project",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm run build --prefix frontend",
    "dev": "npm run dev --prefix frontend",
    "test": "npm run test --prefix frontend",
    "test:rules": "npm run test:rules --prefix frontend",
    "test:firestore-rules": "node scripts/run-rules-tests.js",
    "desktop:build": "cd frontend && npx tauri build",
    "desktop:dev": "cd frontend && npx tauri dev",
    "desktop:publish": "powershell -File scripts/publish-desktop.ps1",
    "deploy": "powershell -NoProfile -NonInteractive -File deploy.ps1",
    "deploy:all": "powershell -NoProfile -NonInteractive -File deploy.ps1"
  }
}
