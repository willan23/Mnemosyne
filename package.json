{
  "name": "mnemosyne-project",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm run build --prefix frontend",
    "dev": "npm run dev --prefix frontend",
    "test": "npm run test --prefix frontend",
    "test:rules": "npm run test:rules --prefix frontend",
    "backend": "cd backend && venv\\Scripts\\python -m uvicorn main:app --reload",
    "backend:install": "cd backend && venv\\Scripts\\python -m pip install -r requirements.txt",
    "desktop:build": "cd frontend && npx tauri build",
    "desktop:dev": "cd frontend && npx tauri dev",
    "deploy": "firebase deploy --only hosting,firestore,storage",
    "deploy:all": "powershell -File deploy.ps1"
  }
}
